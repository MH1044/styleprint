{
  "name": "@styleprint/server",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "bundle:desktop": "node scripts/bundle-desktop.mjs",
    "test:db": "vitest run tests/db.test.ts",
    "test:ingest": "vitest run tests/ingest.test.ts",
    "test:fingerprint": "vitest run tests/fingerprint.test.ts",
    "test:ai": "vitest run tests/ai.test.ts",
    "test:embeddings": "vitest run tests/embeddings.test.ts",
    "test:pipeline": "vitest run tests/pipeline.test.ts tests/learning.test.ts",
    "test:export": "vitest run tests/export.test.ts tests/document.test.ts",
    "test:publik": "vitest run tests/publik.test.ts"
  },
  "dependencies": {
    "@styleprint/shared": "0.1.2",
    "@thednp/dommatrix": "3.1.2",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "docx": "9.15.1",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "openai": "7.47.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
